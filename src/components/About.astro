---
import site from '../data/site.json';

const { intro, items, current } = site.about;
---
<section class="about" id="about">
    <div class="container">
        <h3 >About</h3>
        <div class="about-wrap">
            <h4 class="word">{intro}</h4>
            {items.map(({ word, proof }) => (
                <div class="wrap-row">
                    <h4>{word}</h4>
                    <p>{proof}</p>
                </div>
            ))}
        </div>
        <a href={current.href} target="_blank" rel="noopener" class="about-current">{current.text}</a>
    </div>
</section>
